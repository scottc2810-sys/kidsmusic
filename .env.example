# Melo configuration. Copy to .env and adjust. Every key is optional.
KM_ENV=production
KM_HOST=127.0.0.1          # use 0.0.0.0 to reach Melo from other devices on your network
KM_PORT=8000
# KM_DATA_DIR=./data       # database, encrypted recordings, generated keys

# AI teacher (the "brain"). Easiest: choose it in the app under Parent -> AI brain (saved to brain.json
# in the data folder, which wins over this file). Or set it here:
#   auto        = Claude API if ANTHROPIC_API_KEY is set, else the local Claude Code CLI, else an
#                 OpenAI-compatible server (KM_LLM_BASE_URL), else a running Ollama, else offline.
#   claude_code = the local `claude` CLI on your Claude Code login. No API key. Run `claude` once and log in.
#   ollama      = a local model through Ollama (free, private): install from ollama.com, `ollama pull llama3.2`.
#   openai      = any OpenAI-compatible endpoint: LM Studio, llama.cpp, Jan, vLLM (local) or OpenAI,
#                 OpenRouter, Groq, Gemini, Mistral, DeepSeek (online, your own key).
#   offline     = built-in teacher only.
KM_AI_PROVIDER=auto
# KM_OLLAMA_URL=http://127.0.0.1:11434
# KM_OLLAMA_MODEL=                   # empty = pick a chat model from what is installed
# KM_LLM_BASE_URL=http://127.0.0.1:1234/v1     # e.g. LM Studio; https://openrouter.ai/api/v1 for OpenRouter
# KM_LLM_MODEL=
# KM_LLM_API_KEY=
# KM_LLM_INTERACTIVE_TIMEOUT_SECONDS=8   # a child is waiting: then the offline teacher steps in (a late AI plan is used later)
# KM_LLM_TIMEOUT_SECONDS=180             # background work (personal lines, exercises)
# KM_CLAUDE_CODE_MODEL=sonnet        # or haiku (fastest) / opus
# KM_CLAUDE_CODE_TIMEOUT_SECONDS=30
# ANTHROPIC_API_KEY=sk-ant-...
KM_AI_MODEL=claude-opus-5-5
KM_AI_EFFORT=low           # low keeps replies fast for young children
KM_AI_TIMEOUT_SECONDS=12

# Secrets: generated into KM_DATA_DIR on first run if not set. Back them up with your data folder:
# losing KM_RECORDING_KEY makes stored recordings unreadable.
# KM_SECRET_KEY=
# KM_RECORDING_KEY=

# HTTPS: cookies become Secure automatically on HTTPS requests. Behind a TLS proxy set:
# KM_COOKIE_SECURE=true
# Extra Host headers allowed for Claude Code over HTTP (/mcp/) when not on localhost:
# KM_MCP_ALLOWED_HOSTS=melo.local:8000

# Native-speaker recordings (Parent > Native voices) come from Wikimedia Commons, whose bot policy asks automated
# downloaders for a contact in the User-Agent. Put a web page or an email here (it is sent only to Wikimedia):
# KM_WIKIMEDIA_CONTACT=https://example.org/contact
